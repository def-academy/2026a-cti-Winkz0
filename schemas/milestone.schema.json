{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://def-academy.dev/schemas/milestone.schema.json",
  "title": "MilestoneContract",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "academy/v1" },
    "kind": { "const": "MilestoneContract" },
    "metadata": {
      "type": "object",
      "required": ["id", "course", "course_version", "title", "week", "effort_hours"],
      "additionalProperties": false,
      "properties": {
        "id":             { "type": "string", "pattern": "^[a-z]+-m[0-9]{2}$" },
        "course":         { "type": "string", "enum": ["cti", "dfir"] },
        "course_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "title":          { "type": "string", "minLength": 8 },
        "week":           { "type": "integer", "minimum": 1, "maximum": 20 },
        "effort_hours":   { "type": "integer", "minimum": 1, "maximum": 40 }
      }
    },
    "spec": {
      "type": "object",
      "required": ["validator", "required_artifacts", "required_checks", "defense"],
      "additionalProperties": false,
      "properties": {
        "depends_on":    { "type": "array", "items": { "type": "string" } },
        "capstone_gate": { "type": "boolean", "default": true },
        "validator": {
          "type": "object",
          "required": ["repo", "workflow", "ref"],
          "additionalProperties": false,
          "properties": {
            "repo":     { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
            "workflow": { "type": "string" },
            "ref":      { "type": "string" }
          }
        },
        "required_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "kind", "checks"],
            "additionalProperties": false,
            "properties": {
              "path":   { "type": "string" },
              "kind":   { "type": "string", "enum": ["adr","config","code","report","stix","sigma","iac","runbook","data"] },
              "checks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "weight": { "type": "number", "minimum": 0, "maximum": 100, "default": 10 }
            }
          }
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id":       { "type": "string" },
              "blocking": { "type": "boolean", "default": true },
              "weight":   { "type": "number", "default": 10 }
            }
          }
        },
        "integrity_signals": { "type": "array", "items": { "type": "string" } },
        "defense": {
          "type": "object",
          "required": ["required"],
          "additionalProperties": false,
          "properties": {
            "required":      { "type": "boolean" },
            "min_score":     { "type": "number", "minimum": 0, "maximum": 100, "default": 70 },
            "code_question": { "type": "boolean", "default": true },
            "prompts":       { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
